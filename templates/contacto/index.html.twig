{% extends 'base.html.twig' %}

{% block title %}Contacto{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <h1>Contacto</h1>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h3>Información de Contacto</h3>
                <div style="margin-top: 2rem;">
                    <p><strong>📧 Email:</strong> <a href="mailto:info@bispol.es">info@bispol.es</a></p>
                    <p><strong>📞 Teléfono:</strong> <a href="tel:+34620176259">+34 620 17 62 59</a></p>
                    <p><strong>📍 Dirección:</strong><br>
                    BISPOL - Centre de Formació<br>
                    Calle del Ter, 14, 1C<br>
                    07009 Palma, Illes Balears</p>
                    <p><strong>🕐 Horario de Atención:</strong><br>
                    Lunes a Jueves: 16:00 - 20:00</p>
                </div>
            </div>
            <div class="col-md-6">
                <h3>Envíanos un Mensaje</h3>
                <p class="text-muted">Completa el formulario y nos pondremos en contacto contigo lo antes posible.</p>
                
                {{ form_start(form) }}
                    {{ form_row(form.nombre) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.asunto) }}
                    {{ form_row(form.mensaje) }}
                    
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary">Enviar Mensaje</button>
                        <a href="{% if app.user %}{{ path('app_dashboard') }}{% else %}{{ path('app_home') }}{% endif %}" class="btn btn-secondary">Cancelar</a>
                    </div>
                    {% include 'partials/_informacion_datos.html.twig' with {finalidad: 'responder tu mensaje'} %}
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Gestionar Alumnos - {{ grupo.nombre }}{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <h1>Gestionar Alumnos: {{ grupo.nombre }}</h1>
    </div>
    <div class="card-body">
        <form method="post">
            <div class="form-group">
                <label class="form-label"><strong>Selecciona los alumnos que pertenecerán a este grupo:</strong></label>
                <div style="max-height: 520px; overflow-y: auto; border: 1px solid #ddd; padding: 1rem; border-radius: 4px; margin-top: 0.5rem;">
                    {% include 'form/_lista_alumnos_categoria.html.twig' with {
                        usuarios: todosAlumnos,
                        input_name: 'alumnos[]',
                        id_prefix: 'alumno',
                        seleccionados: grupo.alumnos|map(alumno => alumno.id),
                        mostrar_username: true
                    } %}
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Guardar Asignaciones</button>
                <a href="{{ path('app_grupo_show', {'id': grupo.id}) }}" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}


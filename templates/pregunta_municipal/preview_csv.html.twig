{% extends 'base.html.twig' %}

{% block title %}{{ titulo|default('Previsualizar Preguntas CSV') }}{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <h1>{{ titulo|default('Previsualizar Preguntas CSV') }}</h1>
    </div>
    <div class="card-body">
        <div class="alert alert-info mb-4">
            <h5>Información de las preguntas:</h5>
            <ul class="mb-0">
                <li><strong>Municipio:</strong> {{ municipio.nombre }}</li>
                {% if temasAleatorios|default(false) %}
                    <li><strong>Temas municipales:</strong> {{ nombresTemas|join(', ') }}. Cada pregunta indica el suyo.</li>
                {% else %}
                    <li><strong>Tema Municipal:</strong> {{ temaMunicipal.nombre }}</li>
                {% endif %}
                <li><strong>Dificultad:</strong> 
                    {% if dificultad == 'facil' %}Fácil
                    {% elseif dificultad == 'moderada' %}Moderada
                    {% elseif dificultad == 'dificil' %}Difícil
                    {% else %}Indeterminado
                    {% endif %}
                </li>
                <li><strong>Total de preguntas:</strong> {{ total }}</li>
                {% if editable|default(false) and omitidas|default([]) is not empty %}
                    <li><strong>Dejadas fuera:</strong> {{ omitidas|length }}</li>
                {% endif %}
                <li>
                    <strong>Nuevas:</strong> 
                    {% set nuevas = preguntas|filter(p => not p.id)|length %}
                    {{ nuevas }}
                </li>
                <li>
                    <strong>Actualizaciones:</strong> 
                    {% set actualizaciones = preguntas|filter(p => p.id)|length %}
                    {{ actualizaciones }}
                </li>
            </ul>
        </div>

        {% if examenPegado|default(null) %}
            {% include 'examen_semanal/_pegar_resumen.html.twig' %}
        {% endif %}

        {% if editable|default(false) %}
            {% if omitidas|default([]) is not empty %}
                <div class="alert alert-warning">
                    <strong>Estas preguntas no se tendrán en cuenta:</strong>
                    <ul class="mb-0 mt-2">
                        {% for aviso in omitidas %}
                            <li>{{ aviso }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
            <form method="post" action="{{ path('app_pregunta_municipal_confirmar_crear_csv') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('confirmar_csv_municipal') }}">
                <input type="hidden" name="accion" value="{{ total > 0 ? 'guardar' : 'comprobar' }}">
                <div class="mb-4">
                    <h4 class="mb-3">Preguntas</h4>
                    {% include 'pregunta/_preview_preguntas.html.twig' with {
                        mostrarTema: temasAleatorios|default(false),
                        mostrarLey: false
                    } %}
                </div>
                <div class="d-flex gap-2">
                    {% if total > 0 %}
                        <button type="submit" class="btn btn-success">{% if examenPegado|default(null) %}Crear examen semanal con{% else %}Guardar{% endif %} {{ total }} pregunta{% if total != 1 %}s{% endif %}</button>
                    {% else %}
                        <button type="submit" class="btn btn-primary">Comprobar de nuevo</button>
                    {% endif %}
                    <a href="{{ path(volver|default('app_pregunta_municipal_new_csv')) }}" class="btn btn-secondary">Volver</a>
                </div>
            </form>
        {% else %}
        <div class="mb-4">
            <h4>Preguntas a crear:</h4>
            <div style="max-height: 500px; overflow-y: auto; border: 1px solid #ddd; border-radius: 4px; padding: 1rem;">
                {% for pregunta in preguntas %}
                    <div class="card mb-3" style="border-left: 4px solid {% if pregunta.id %}var(--color-warning){% else %}var(--color-primary){% endif %};">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="mb-0">
                                    {% if pregunta.id %}
                                        <span class="badge badge-warning" style="background-color: var(--color-warning); color: white; margin-right: 0.5rem;">ACTUALIZAR</span>
                                        Pregunta #{{ loop.index }} (ID: {{ pregunta.id }})
                                    {% else %}
                                        Pregunta #{{ loop.index }} (NUEVA)
                                    {% endif %}
                                </h6>
                                <small class="text-muted">Línea {{ pregunta.linea }}</small>
                            </div>
                            {% if pregunta.temaNombre is defined and pregunta.temaNombre %}
                                <p class="mb-2"><strong>Tema:</strong> {{ pregunta.temaNombre }}</p>
                            {% endif %}
                            <p class="mb-2"><strong>Texto:</strong> {{ pregunta.texto }}</p>
                            {% if pregunta.articulo is defined and pregunta.articulo %}
                                <p class="mb-2"><strong>Artículo:</strong> {{ pregunta.articulo }}</p>
                            {% endif %}
                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <small><strong>A)</strong> {{ pregunta.opcionA }}</small>
                                </div>
                                <div class="col-md-6">
                                    <small><strong>B)</strong> {{ pregunta.opcionB }}</small>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <small><strong>C)</strong> {{ pregunta.opcionC }}</small>
                                </div>
                                <div class="col-md-6">
                                    <small><strong>D)</strong> {{ pregunta.opcionD }}</small>
                                </div>
                            </div>
                            <p class="mb-1">
                                <strong>Respuesta correcta:</strong> 
                                <span class="badge badge-success" style="background-color: var(--color-success); color: white;">
                                    {{ pregunta.respuestaCorrecta }}
                                </span>
                            </p>
                            {% if pregunta.retroalimentacion %}
                                <p class="mb-0">
                                    <strong>Retroalimentación:</strong> 
                                    <small>{{ pregunta.retroalimentacion }}</small>
                                </p>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <form method="post" action="{{ path('app_pregunta_municipal_confirmar_crear_csv') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('confirmar_csv_municipal') }}">
            <div class="d-flex gap-2">
                {% set nuevas = preguntas|filter(p => not p.id)|length %}
                {% set actualizaciones = preguntas|filter(p => p.id)|length %}
                <button type="submit" class="btn btn-success">
                    Confirmar y Procesar {{ total }} Preguntas
                    {% if nuevas > 0 and actualizaciones > 0 %}
                        ({{ nuevas }} nuevas, {{ actualizaciones }} actualizaciones)
                    {% elseif nuevas > 0 %}
                        ({{ nuevas }} nuevas)
                    {% elseif actualizaciones > 0 %}
                        ({{ actualizaciones }} actualizaciones)
                    {% endif %}
                </button>
                <a href="{{ path(volver|default('app_pregunta_municipal_new_csv')) }}" class="btn btn-secondary">Volver</a>
            </div>
        </form>
        {% endif %}
    </div>
</div>
{% endblock %}

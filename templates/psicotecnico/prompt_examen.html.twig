{% extends 'base.html.twig' %}

{% block title %}Prompt de examen psicotécnico{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'psicotecnico/_estilos_vista.html.twig' %}
    <style>
        .psico-areas {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .psico-area {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            min-height: 40px;
            margin: 0;
            padding: 0.4rem 0.8rem;
            border: 1px solid #d4c4ee;
            border-radius: 999px;
            background: #fff;
            color: #4a1d96;
            font-weight: 600;
            cursor: pointer;
        }

        .psico-area input {
            margin: 0;
        }
    </style>
{% endblock %}

{% block body %}
<div class="psico-pagina">
    <div class="psico-cabecera">
        <div>
            <h1>Prompt de examen psicotécnico</h1>
            <p>Elige una o varias áreas. Si dejas el número de preguntas vacío, sale el simulacro de 14 por área. Si indicas un total, ese número manda y se reparte a partes iguales. Copia el prompt y adjunta el logo de Bispol y el PDF Simulacro_psicotecnico_Bispol.</p>
        </div>
        <div class="psico-cabecera-acciones">
            <a href="{{ path('app_archivo_psicotecnico_index') }}" class="btn btn-secondary">Archivos</a>
        </div>
    </div>

    <form method="get" action="{{ path('app_psicotecnico_prompt_examen') }}">
        <div class="psico-panel">
            <input type="hidden" name="formulario" value="1">
            <div class="form-group" style="margin-bottom: 0.9rem;">
                <span class="form-label">Áreas</span>
                <div class="psico-areas">
                    {% for clave, nombre in areas %}
                        <label class="psico-area">
                            <input type="checkbox" name="areas[]" value="{{ clave }}" {% if clave in seleccion %}checked{% endif %} onchange="this.form.requestSubmit()">
                            {{ nombre }}
                        </label>
                    {% endfor %}
                </div>
            </div>
            <div class="psico-filtros">
                <div class="form-group">
                    <label class="form-label" for="psico-nivel">Nivel de dificultad</label>
                    <select id="psico-nivel" name="nivel" class="form-control">
                        {% for valor, etiqueta in niveles %}
                            <option value="{{ valor }}" {% if nivel == valor %}selected{% endif %}>{{ etiqueta }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="psico-preguntas">Número de preguntas</label>
                    <input id="psico-preguntas" type="number" name="preguntas" class="form-control" min="1" max="{{ maximoPreguntas }}" step="1" inputmode="numeric" placeholder="Vacío: 14 por área" value="{{ preguntasTexto }}" onchange="this.form.requestSubmit()">
                </div>
                <div class="psico-filtros-botones">
                    <button type="submit" class="btn btn-primary">Actualizar prompt</button>
                    <button type="button" class="btn btn-secondary" id="psico-copiar">Copiar prompt</button>
                </div>
            </div>
            <div class="form-group" id="psico-nivel-libre" style="margin-top: 0.85rem;" {% if nivel != 'otro' %}hidden{% endif %}>
                <label class="form-label" for="psico-nivel-texto">Nivel que quieres</label>
                <input id="psico-nivel-texto" type="text" name="nivel_texto" class="form-control" maxlength="{{ maximoNivel }}" placeholder="Por ejemplo: primero de la ESO" value="{{ nivelTexto }}" onchange="this.form.requestSubmit()">
            </div>
            <p class="psico-resumen" style="margin-top: 0.9rem;">
                {% if prompt is null %}
                    {% if seleccion is empty %}
                        Selecciona al menos un área.
                    {% elseif nivelPendiente %}
                        Escribe el nivel de dificultad. Por ejemplo: primero de la ESO.
                    {% else %}
                        Corrige el número de preguntas para generar el prompt. Vacío usa 14 por área; un total se reparte a partes iguales y hace falta al menos una pregunta por área.
                    {% endif %}
                {% elseif personalizado %}
                    {{ total }} preguntas en {{ minutos }} minutos
                    ({{ seleccion|length }} {{ seleccion|length == 1 ? 'área' : 'áreas' }}:
                    {% for clave in seleccion %}{{ areas[clave] }} {{ reparto[clave] }}{% if not loop.last %}, {% endif %}{% endfor %}).
                    Este total sustituye a las 14 por área del simulacro.
                    La portada lleva la distribución, después las preguntas y al final las soluciones.
                    {% if 'memoria' in seleccion %}
                        Si entra memoria visual, el PDF incluye la lámina antes de las preguntas.
                    {% endif %}
                {% else %}
                    {{ total }} preguntas en {{ minutos }} minutos
                    ({{ seleccion|length }} {{ seleccion|length == 1 ? 'área' : 'áreas' }}).
                    Sin un total, el prompt es el del simulacro: 14 preguntas por área.
                    La portada lleva la distribución, después las preguntas y al final las soluciones.
                    {% if 'memoria' in seleccion %}
                        Si entra memoria visual, el PDF incluye la lámina antes de las preguntas.
                    {% endif %}
                {% endif %}
                {% if nivel == 'otro' and nivelTexto %}
                    El nivel del prompt es «{{ nivelTexto }}».
                {% elseif nivel == 'alto' %}
                    El nivel alto pide preguntas muy difíciles, de varios pasos, con distractores que cazan el cálculo a medias.
                {% elseif nivel != 'otro' %}
                    El nivel normal pide preguntas de convocatoria estándar, de uno o dos pasos.
                {% endif %}
                El PDF de ejemplo marca la maqueta, no los ejercicios: cada examen tiene que cambiar el tipo de tarea, también la lámina de memoria.
                Al pegar el prompt adjunta dos archivos: el
                <a href="{{ asset('images/logo-bispol.png') }}" target="_blank" rel="noopener">logo de Bispol</a>
                y el PDF <strong>Simulacro_psicotecnico_Bispol</strong>, para que copie su formato y sus estilos.
            </p>
        </div>
    </form>

    <div class="psico-panel">
        <label class="form-label" for="psico-prompt">Prompt para copiar</label>
        <textarea id="psico-prompt" class="form-control" readonly rows="28" style="width: 100%; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; line-height: 1.45;">{{ prompt|default('') }}</textarea>
        <p id="psico-copiado" class="psico-resumen" hidden>Prompt copiado.</p>
    </div>
</div>
<script>
(function () {
    const boton = document.getElementById('psico-copiar');
    const area = document.getElementById('psico-prompt');
    const aviso = document.getElementById('psico-copiado');
    if (!boton || !area) {
        return;
    }
    const formulario = boton.closest('form') || document.querySelector('.psico-pagina form');
    const nivel = document.getElementById('psico-nivel');
    const nivelLibre = document.getElementById('psico-nivel-libre');
    const nivelTexto = document.getElementById('psico-nivel-texto');
    if (nivel && nivelLibre) {
        nivel.addEventListener('change', function () {
            const otro = nivel.value === 'otro';
            nivelLibre.hidden = !otro;
            if (!otro && nivelTexto) {
                nivelTexto.value = '';
                nivel.form.requestSubmit();
                return;
            }
            if (nivelTexto) {
                nivelTexto.focus();
            }
        });
    }
    if (formulario) {
        formulario.addEventListener('submit', function (event) {
            if (formulario.querySelectorAll('input[name="areas[]"]:checked').length === 0) {
                event.preventDefault();
                alert('Selecciona al menos un área.');
            }
        });
    }
    boton.addEventListener('click', function () {
        const texto = area.value;
        if (texto.trim() === '') {
            alert('No hay prompt para copiar. Revisa las áreas y el número de preguntas.');
            return;
        }
        const listo = function () {
            if (!aviso) {
                return;
            }
            aviso.hidden = false;
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(texto).then(listo).catch(function () {
                area.select();
                document.execCommand('copy');
                listo();
            });
            return;
        }
        area.select();
        document.execCommand('copy');
        listo();
    });
})();
</script>
{% endblock %}

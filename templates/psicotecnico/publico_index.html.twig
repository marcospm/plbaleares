{% extends 'base.html.twig' %}
{% import 'psicotecnico/_enlace_archivo.html.twig' as psico %}

{% block title %}Psicotécnicos{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'psicotecnico/_estilos_vista.html.twig' %}
{% endblock %}

{% block body %}
<div class="psico-pagina">
    <div class="psico-cabecera">
        <div>
            <h1>Psicotécnicos</h1>
            <p>Apuntes y ejercicios por categoría. Cada publicación puede incluir uno o varios archivos.</p>
        </div>
    </div>

    <form method="get" action="{{ path('app_psicotecnico_publico_index') }}">
        <div class="psico-panel">
            <div class="psico-filtros">
                <div class="form-group">
                    <label class="form-label" for="psico-alumno-buscar">Buscar</label>
                    <input id="psico-alumno-buscar" type="text" name="search" value="{{ search }}" class="form-control" placeholder="Nombre del archivo">
                </div>
                <div class="form-group">
                    <label class="form-label" for="psico-alumno-categoria">Categoría</label>
                    <select id="psico-alumno-categoria" name="categoria" class="form-control">
                        <option value="">Todas</option>
                        {% for categoria in categorias %}
                            <option value="{{ categoria.id }}" {% if categoriaId == categoria.id %}selected{% endif %}>{{ categoria.nombre }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="psico-filtros-botones">
                    <button type="submit" class="btn btn-primary">Filtrar</button>
                    <a href="{{ path('app_psicotecnico_publico_index') }}" class="btn btn-secondary">Limpiar</a>
                </div>
            </div>
        </div>
    </form>

    {% if categorias|length > 0 %}
        <div class="psico-chips">
            <a href="{{ path('app_psicotecnico_publico_index', {search: search}) }}" class="psico-chip {% if not categoriaId %}is-active{% endif %}">Todas</a>
            {% for categoria in categorias %}
                <a href="{{ path('app_psicotecnico_publico_index', {categoria: categoria.id, search: search}) }}" class="psico-chip {% if categoriaId == categoria.id %}is-active{% endif %}">{{ categoria.nombre }}</a>
            {% endfor %}
        </div>
    {% endif %}

    {% if grupos|length > 0 %}
        <p class="psico-resumen">{{ grupos|length }} {{ grupos|length == 1 ? 'publicación' : 'publicaciones' }}</p>
        <div class="psico-lista">
            {% for grupo in grupos %}
                {% set principal = grupo.archivos|first %}
                <article class="psico-card">
                    <div class="psico-card-info">
                        <div class="psico-card-top">
                            <h2>{{ grupo.nombre }}</h2>
                            {% if grupo.fecha %}
                                <time class="psico-fecha" datetime="{{ grupo.fecha|date('Y-m-d') }}">{{ grupo.fecha|date('d/m/Y') }}</time>
                            {% endif %}
                        </div>
                        {% if grupo.descripcion %}
                            <p class="psico-desc">{{ grupo.descripcion }}</p>
                        {% endif %}
                        <div class="psico-badges">
                            {% for categoria in principal.categorias %}
                                {% if categoria.activo %}
                                    <span class="psico-badge">{{ categoria.nombre }}</span>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                    <div class="psico-archivos">
                        {% for archivo in grupo.archivos %}
                            {{ psico.enlace(archivo) }}
                        {% endfor %}
                    </div>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <div class="psico-vacio">
            <p>Todavía no hay archivos de psicotécnicos en esta categoría.</p>
        </div>
    {% endif %}
</div>
{% endblock %}

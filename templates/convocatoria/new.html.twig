{% extends 'base.html.twig' %}

{% block title %}Nueva Convocatoria{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .convocatoria-fechas {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 0.75rem;
            align-items: start;
        }
        @media (max-width: 768px) {
            .convocatoria-fechas {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <h1>Nueva Convocatoria</h1>
    </div>
    <div class="card-body">
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
            {{ form_row(form.nombre) }}
            {{ form_row(form.municipios) }}
            <div class="convocatoria-fechas">
                {{ form_row(form.fechaInscripcion) }}
                {{ form_row(form.fechaTeorico) }}
                {{ form_row(form.fechaFisicas) }}
                {{ form_row(form.fechaPsicotecnico) }}
            </div>
            {{ form_row(form.basesPdf) }}
            {{ form_row(form.activo) }}
            
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a href="{{ path('app_convocatoria_index') }}" class="btn btn-secondary">Cancelar</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}













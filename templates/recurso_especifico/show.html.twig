{% extends 'base.html.twig' %}

{% block title %}Ver Recurso Específico{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h1>{{ nombreGrupo|default(recursoEspecifico.nombre) }}</h1>
            <div>
                <a href="{{ path('app_recurso_especifico_edit', {'id': recursoEspecifico.id}) }}" class="btn btn-primary">Editar</a>
                <a href="{{ path('app_recurso_especifico_index') }}" class="btn btn-secondary">Volver</a>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div style="margin-bottom: 1.5rem;">
            <h3>Descripción</h3>
            <p>{{ recursoEspecifico.descripcion ?? 'Sin descripción' }}</p>
        </div>

        <div style="margin-bottom: 1.5rem;">
            <h3>Contenido</h3>
            {% if recursosGrupo is defined and recursosGrupo|length > 1 %}
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    {% for recurso in recursosGrupo %}
                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; padding: 0.6rem 0.75rem; background: #f5f5f5; border-radius: 4px;">
                            <span>{{ recurso.nombreArchivoOriginal|default(recurso.nombre) }}</span>
                            {% if recurso.tieneArchivo %}
                                <a href="{{ recurso.rutaArchivo }}" target="_blank" class="btn btn-sm btn-primary" rel="noopener noreferrer">Descargar</a>
                            {% elseif recurso.tieneEnlace %}
                                <a href="{{ recurso.enlace }}" target="_blank" class="btn btn-sm btn-primary" rel="noopener noreferrer">Abrir enlace</a>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% elseif recursoEspecifico.tieneEnlace %}
                <p>
                    <strong>Tipo:</strong> Enlace externo<br>
                    <a href="{{ recursoEspecifico.enlace }}" target="_blank" class="btn btn-primary" rel="noopener noreferrer">Abrir enlace</a>
                </p>
            {% elseif recursoEspecifico.tieneArchivo %}
                <p>
                    <strong>Tipo:</strong> Archivo adjunto<br>
                    <strong>Nombre:</strong> {{ recursoEspecifico.nombreArchivoOriginal ?? 'Sin nombre' }}<br>
                    <a href="{{ recursoEspecifico.rutaArchivo }}" target="_blank" class="btn btn-primary" rel="noopener noreferrer">Descargar archivo</a>
                </p>
            {% else %}
                <p class="text-muted">No hay archivo ni enlace asociado.</p>
            {% endif %}
        </div>

        <div>
            <h3>Información</h3>
            <p>
                <strong>Profesor:</strong> {{ recursoEspecifico.profesor.nombreDisplay }}<br>
                {% if recursoEspecifico.convocatorias|length > 0 %}
                    <strong>Convocatorias:</strong>
                    {% for convocatoria in recursoEspecifico.convocatorias %}
                        {{ convocatoria.nombre }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                    <br>
                {% endif %}
                <strong>Fecha de creación:</strong> {{ recursoEspecifico.fechaCreacion|date('d/m/Y H:i') }}
            </p>
        </div>
    </div>
</div>
{% endblock %}












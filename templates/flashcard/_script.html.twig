<div id="flashcard-config" hidden
     data-url="{{ path('app_flashcard_guardar') }}"
     data-listado="{{ path('app_flashcard_index') }}"
     data-token="{{ csrf_token('flashcard_guardar') }}"></div>
<script>
if (!window.flashcardExamenIniciado) {
    window.flashcardExamenIniciado = true;

    function flashcardEtiqueta(texto, id) {
        const label = document.createElement('label');
        label.htmlFor = id;
        label.textContent = texto;
        label.style.cssText = 'display:block;font-weight:600;margin-bottom:0.35rem;';
        return label;
    }

    function flashcardArea(nombre, id, valor, filas) {
        const area = document.createElement('textarea');
        area.name = nombre;
        area.id = id;
        area.className = 'form-control';
        area.rows = filas;
        area.required = true;
        area.maxLength = 8000;
        area.value = valor;
        area.style.cssText = 'width:100%;margin-bottom:0.75rem;';
        return area;
    }

    function flashcardBoton(tipo, clase, texto) {
        const boton = document.createElement('button');
        boton.type = tipo;
        boton.className = clase;
        boton.textContent = texto;
        return boton;
    }

    function crearPanelFlashcard(boton) {
        const config = document.getElementById('flashcard-config');
        if (!config) {
            return null;
        }
        const clave = boton.getAttribute('data-clave');
        const panel = document.createElement('div');
        panel.id = 'flashcard-panel-' + clave;
        panel.className = 'flashcard-panel';
        panel.style.cssText = 'margin-top:0.75rem;padding:1rem;background:#f4f8fb;border:1px solid #c5d9ea;border-radius:8px;';

        const intro = document.createElement('p');
        intro.style.cssText = 'margin:0 0 0.75rem;color:#35556e;font-size:0.9rem;';
        intro.append('Se guarda en ');
        const tema = document.createElement('strong');
        tema.className = 'js-flashcard-tema';
        tema.textContent = boton.getAttribute('data-tema') || 'Sin tema';
        intro.append(tema);
        intro.append('. La pregunta y la respuesta ya vienen escritas: cámbialas si quieres y luego guárdala.');
        panel.append(intro);

        const form = document.createElement('form');
        form.className = 'form-flashcard';
        form.method = 'post';
        form.action = config.getAttribute('data-url') || '';
        form.setAttribute('data-turbo', 'false');
        form.setAttribute('data-boton', boton.id);
        form._sugeridoAnverso = boton.getAttribute('data-sugerido-anverso') || boton.getAttribute('data-anverso') || '';
        form._sugeridoReverso = boton.getAttribute('data-sugerido-reverso') || boton.getAttribute('data-reverso') || '';

        [['_token', config.getAttribute('data-token') || ''], ['tipo', boton.getAttribute('data-tipo') || 'general'], ['preguntaId', boton.getAttribute('data-pregunta-id') || '']].forEach(function (par) {
            const campo = document.createElement('input');
            campo.type = 'hidden';
            campo.name = par[0];
            campo.value = par[1];
            form.append(campo);
        });

        form.append(flashcardEtiqueta('Pregunta', 'flashcard-anverso-' + clave));
        form.append(flashcardArea('anverso', 'flashcard-anverso-' + clave, boton.getAttribute('data-anverso') || '', 3));
        form.append(flashcardEtiqueta('Respuesta', 'flashcard-reverso-' + clave));
        form.append(flashcardArea('reverso', 'flashcard-reverso-' + clave, boton.getAttribute('data-reverso') || '', 5));

        const acciones = document.createElement('div');
        acciones.style.cssText = 'display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;';
        acciones.append(flashcardBoton('submit', 'btn btn-primary btn-sm', boton.getAttribute('data-guardada') === '1' ? 'Guardar cambios' : 'Guardar flashcard'));
        const restaurar = flashcardBoton('button', 'btn btn-secondary btn-sm', 'Volver al texto sugerido');
        restaurar.setAttribute('data-flashcard-restaurar', '');
        acciones.append(restaurar);
        const cerrar = flashcardBoton('button', 'btn btn-secondary btn-sm', 'Cerrar');
        cerrar.setAttribute('data-flashcard-cerrar', panel.id);
        cerrar.setAttribute('data-flashcard-boton', boton.id);
        acciones.append(cerrar);
        const enlace = document.createElement('a');
        enlace.href = config.getAttribute('data-listado') || '#';
        enlace.className = 'btn btn-secondary btn-sm';
        enlace.textContent = 'Mis flashcards';
        acciones.append(enlace);
        form.append(acciones);

        const estado = document.createElement('p');
        estado.className = 'js-flashcard-estado';
        estado.hidden = true;
        estado.style.cssText = 'margin:0.75rem 0 0;color:#1e7e34;font-weight:600;';
        form.append(estado);
        panel.append(form);
        return panel;
    }

    document.addEventListener('click', function (event) {
        const objetivo = event.target;
        if (!objetivo || !objetivo.closest) {
            return;
        }
        const abrir = objetivo.closest('[data-flashcard-abrir]');
        if (abrir) {
            const clave = abrir.getAttribute('data-clave');
            let panel = document.getElementById('flashcard-panel-' + clave);
            if (!panel) {
                panel = crearPanelFlashcard(abrir);
                if (!panel || !abrir.parentElement) {
                    return;
                }
                abrir.parentElement.append(panel);
            }
            panel.hidden = false;
            abrir.hidden = true;
            const area = panel.querySelector('textarea[name="anverso"]');
            if (area) {
                area.focus();
            }
            return;
        }

        const cerrar = event.target.closest('[data-flashcard-cerrar]');
        if (cerrar) {
            const panel = document.getElementById(cerrar.getAttribute('data-flashcard-cerrar'));
            const boton = document.getElementById(cerrar.getAttribute('data-flashcard-boton'));
            if (panel) {
                panel.hidden = true;
            }
            if (boton) {
                boton.hidden = false;
            }
            return;
        }

        const restaurar = event.target.closest('[data-flashcard-restaurar]');
        if (!restaurar) {
            return;
        }
        const form = restaurar.closest('form');
        if (!form) {
            return;
        }
        const anverso = form.querySelector('[name="anverso"]');
        const reverso = form.querySelector('[name="reverso"]');
        if (anverso) {
            anverso.value = form._sugeridoAnverso || '';
        }
        if (reverso) {
            reverso.value = form._sugeridoReverso || '';
        }
    });

    document.addEventListener('submit', function (event) {
        const form = event.target;
        if (!form || !form.classList || !form.classList.contains('form-flashcard')) {
            return;
        }
        event.preventDefault();

        const boton = form.querySelector('button[type="submit"]');
        const estado = form.querySelector('.js-flashcard-estado');
        const textoOriginal = boton ? boton.textContent : 'Guardar flashcard';
        if (boton) {
            boton.disabled = true;
            boton.textContent = 'Guardando...';
        }

        fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function (response) {
            return response.json().then(function (data) {
                return { ok: response.ok, data: data };
            });
        })
        .then(function (resultado) {
            if (boton) {
                boton.disabled = false;
            }
            if (resultado.ok && resultado.data && resultado.data.ok) {
                if (boton) {
                    boton.textContent = 'Guardar cambios';
                }
                const abre = document.getElementById(form.getAttribute('data-boton'));
                const anversoGuardado = form.querySelector('[name="anverso"]');
                const reversoGuardado = form.querySelector('[name="reverso"]');
                if (abre && anversoGuardado && reversoGuardado) {
                    abre.textContent = 'Editar flashcard';
                    abre.setAttribute('data-guardada', '1');
                    abre.setAttribute('data-anverso', anversoGuardado.value);
                    abre.setAttribute('data-reverso', reversoGuardado.value);
                }
                const tema = form.querySelector('.js-flashcard-tema');
                if (tema && resultado.data.tema) {
                    tema.textContent = resultado.data.tema;
                }
                if (estado) {
                    estado.hidden = false;
                    estado.textContent = 'Guardada en ' + (resultado.data.tema || 'tu tema') + '. Puedes seguir editándola.';
                }
                return;
            }
            throw new Error((resultado.data && resultado.data.error) || 'No se pudo guardar la flashcard.');
        })
        .catch(function (error) {
            if (boton) {
                boton.disabled = false;
                boton.textContent = textoOriginal;
            }
            alert(error.message || 'No se pudo guardar la flashcard.');
        });
    });
}
</script>

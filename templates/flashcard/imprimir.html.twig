{% extends 'base.html.twig' %}

{% block title %}Imprimir flashcards{% endblock %}

{% block body %}
<style>
    .flashcard-hoja {
        break-inside: avoid;
        page-break-inside: avoid;
        border: 1px solid #222;
        border-radius: 8px;
        padding: 1rem 1.1rem;
        margin: 0 0 1rem;
    }
    .flashcard-hoja .etiqueta {
        margin: 0 0 0.35rem;
        font-size: 0.75rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #555;
    }
    .flashcard-respuesta {
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px dashed #999;
    }
    .flashcard-tema {
        margin: 0 0 0.75rem;
        font-weight: 700;
        font-size: 1rem;
        line-height: 1.3;
    }
    @media print {
        nav,
        footer,
        .breadcrumb-nav,
        .alert,
        .no-imprimir,
        #modalTema,
        #mobileWarningModal,
        #cookie-banner {
            display: none !important;
        }
        html,
        body,
        .container,
        .flashcard-imprimir {
            background: white !important;
            margin: 0 !important;
            padding: 0 !important;
            max-width: none !important;
            width: auto !important;
            box-shadow: none !important;
        }
        .flashcard-hoja {
            border-radius: 0;
            box-shadow: none !important;
        }
    }
    @page {
        margin: 12mm;
    }
</style>

<div class="flashcard-imprimir">
    <div class="no-imprimir" style="display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-bottom: 1.5rem;">
        <button type="button" class="btn btn-primary" onclick="window.print()">Imprimir</button>
        <a href="{{ path('app_flashcard_index') }}" class="btn btn-secondary">Volver a mis flashcards</a>
        <span style="color: #666;">{{ total }} {{ total == 1 ? 'flashcard' : 'flashcards' }}. En el cuadro de impresión puedes guardarlo como PDF. Solo se imprime el recuadro de cada flashcard.</span>
    </div>

    <div id="flashcards-impresion">
        {% for grupo in grupos %}
            {% for flashcard in grupo.flashcards %}
                <article class="flashcard-hoja">
                    <p class="flashcard-tema">{{ grupo.nombre }}</p>
                    {% if flashcard.pregunta and flashcard.pregunta.ley %}
                        <p style="margin: -0.35rem 0 0.75rem; color: #333;">{{ flashcard.pregunta.ley.nombre }}</p>
                    {% endif %}
                    <p class="etiqueta">Pregunta</p>
                    <div style="line-height: 1.5;">{{ flashcard.anverso|nl2br }}</div>
                    <div class="flashcard-respuesta">
                        <p class="etiqueta">Respuesta</p>
                        <div style="line-height: 1.5;">{{ flashcard.reverso|nl2br }}</div>
                    </div>
                </article>
            {% endfor %}
        {% endfor %}
    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Prueba de email{% endblock %}

{% block body %}
<div class="container" style="max-width: 640px; margin-top: 2rem;">
    <h1>Prueba de email</h1>
    <p style="color: var(--color-text-light); margin-bottom: 1.5rem;">
        Envía un correo de prueba para verificar que la configuración del mailer funciona.
    </p>

    <div class="card">
        <div class="card-body">
            <div class="alert alert-info" style="margin-bottom: 1.5rem;">
                <strong>Remitente configurado:</strong> {{ mailerFrom }}
            </div>

            <form method="post" action="{{ path('app_email_prueba') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('email_prueba') }}">

                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label for="email" class="form-label">Correo de destino</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="form-control"
                        value="{{ email|default('') }}"
                        required
                        autofocus
                        placeholder="ejemplo@correo.com"
                    >
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" style="flex: 1;">
                        Enviar correo de prueba
                    </button>
                    <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

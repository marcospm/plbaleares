{% extends 'base.html.twig' %}
{% set cantidadPreguntas = cantidadPreguntas|default(20) %}
{% set paraExamen = paraExamen|default(false) %}
{% set tituloPagina = tituloPagina|default(paraExamen ? 'Examen semanal desde el prompt' : 'Pegar preguntas') %}
{% set rutaCancelar = rutaCancelar|default('app_pregunta_index') %}

{% block title %}{{ tituloPagina }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .searchable-select { position: relative; }
        .search-input {
            width: 100%;
            padding: 0.5rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            margin-bottom: 0.5rem;
        }
        .select-options {
            max-height: 200px;
            overflow-y: auto;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: white;
            display: none;
            position: absolute;
            width: 100%;
            z-index: 1000;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .select-options.show { display: block; }
        .select-option {
            padding: 0.5rem;
            cursor: pointer;
            border-bottom: 1px solid #f0f0f0;
        }
        .select-option:hover { background-color: #f8f9fa; }
        .select-option.selected { background-color: #e3f2fd; font-weight: bold; }
        .select-display {
            padding: 0.5rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: white;
            cursor: pointer;
            min-height: 38px;
            display: flex;
            align-items: center;
        }
        .select-display:after { content: '▼'; margin-left: auto; color: #666; }
        #bloque {
            min-height: 280px;
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            font-size: 0.9rem;
        }
        .temas-aleatorios-lista {
            max-height: 280px;
            overflow-y: auto;
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 0.75rem 1rem;
            background: #fff;
        }
    </style>
{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header">
        <h1>{{ tituloPagina }}</h1>
    </div>
    <div class="card-body">
        <div class="alert alert-info">
            <strong>Cómo funciona:</strong>
            <ol class="mb-0">
                {% if paraExamen %}
                    <li>Rellena el nombre, las fechas y, si quieres, el grupo. Las preguntas que salgan de la respuesta serán las del examen semanal.</li>
                {% endif %}
                <li>Elige un tema y su ley, o marca varios temas para que las preguntas se repartan al azar entre ellos. La dificultad se aplica a las {{ cantidadPreguntas }} preguntas.</li>
                <li>No hace falta elegir artículo. Claude indica el artículo en cada bloque. Si el prompt es de varios temas, también indica el tema y la ley de cada pregunta, y cada una se guarda en el suyo.</li>
                <li>Copia el prompt, pégalo en Claude y, debajo de <strong>CONTENIDO:</strong>, pega el texto. El prompt pide {{ cantidadPreguntas }} preguntas{% if paraExamen %}. Si el texto da para menos, el examen se crea con las que sean válidas{% else %}. Como máximo, {{ cantidadPreguntas }}{% endif %}.</li>
            </ol>
        </div>

        <form method="post" action="{{ path('app_pregunta_procesar_pegar') }}" id="pegar-form" data-turbo="false">
            {% if paraExamen %}
                {% include 'examen_semanal/_pegar_datos.html.twig' %}
            {% endif %}
            <div class="mb-3">
                <span class="form-label d-block">Origen de las preguntas</span>
                <div class="d-flex gap-4 flex-wrap">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="modo" id="modo-unico" value="unico" checked>
                        <label class="form-check-label" for="modo-unico">Un tema</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="modo" id="modo-aleatorio" value="aleatorio">
                        <label class="form-check-label" for="modo-aleatorio">Varios temas, al azar</label>
                    </div>
                </div>
                <small class="text-muted" id="modo-ayuda">El prompt se centra en el tema y la ley que elijas.</small>
            </div>

            <div class="row mb-3" id="fila-tema-unico">
                <div class="col-md-6">
                    <label class="form-label">Tema <span class="text-danger">*</span></label>
                    <div class="searchable-select" id="tema-select-container">
                        <div class="select-display" id="tema-display">Selecciona un tema</div>
                        <input type="text" class="search-input" id="tema-search" placeholder="Buscar tema..." style="display: none;">
                        <div class="select-options" id="tema-options">
                            {% for tema in temas %}
                                <div class="select-option" data-value="{{ tema.id }}" data-text="{{ tema.nombre }}">{{ tema.nombre }}</div>
                            {% endfor %}
                        </div>
                        <input type="hidden" name="tema" id="tema-value" required>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Ley <span class="text-danger">*</span></label>
                    <div class="searchable-select" id="ley-select-container">
                        <div class="select-display" id="ley-display">Primero selecciona un tema</div>
                        <input type="text" class="search-input" id="ley-search" placeholder="Buscar ley..." style="display: none;">
                        <div class="select-options" id="ley-options">
                            <div class="select-option" style="color: #999; cursor: default;">Primero selecciona un tema</div>
                        </div>
                        <input type="hidden" name="ley" id="ley-value" required>
                    </div>
                </div>
            </div>

            <div class="mb-3" id="fila-temas-aleatorios" style="display: none;">
                <label class="form-label">Temas del sorteo <span class="text-danger">*</span></label>
                <p class="text-muted mb-2">Marca los temas entre los que se repartirán las preguntas. Cada pregunta saldrá de uno de ellos, al azar.</p>
                <div class="d-flex gap-2 mb-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="temas-aleatorio-todos">Marcar todos</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="temas-aleatorio-ninguno">Quitar todos</button>
                </div>
                <input type="search" class="form-control mb-2" id="temas-aleatorio-buscar" placeholder="Buscar tema...">
                <div class="temas-aleatorios-lista" id="temas-aleatorio-lista">
                    {% for tema in temasDatos %}
                        <div class="form-check mb-2 tema-aleatorio-item" data-text="{{ tema.nombre|e('html_attr') }}">
                            <input class="form-check-input tema-aleatorio-check" type="checkbox" name="temas[]" value="{{ tema.id }}" id="tema-aleatorio-{{ tema.id }}" disabled>
                            <label class="form-check-label" for="tema-aleatorio-{{ tema.id }}">
                                {{ tema.nombre }}
                                {% if tema.leyes is empty %}
                                    <span class="text-muted"> — sin leyes activas</span>
                                {% else %}
                                    <span class="text-muted"> —
                                        {% for ley in tema.leyes %}{{ ley.nombre }}{% if not loop.last %}; {% endif %}{% endfor %}
                                    </span>
                                {% endif %}
                            </label>
                        </div>
                    {% else %}
                        <p class="text-muted mb-0">No hay temas.</p>
                    {% endfor %}
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Dificultad <span class="text-danger">*</span></label>
                    {% import 'examen/_dificultad.html.twig' as dificultadExamen %}
                    {{ dificultadExamen.select('dificultad', 'dificultad', datosExamen.dificultad|default(''), true) }}
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="instruccion-extra">Instrucción extra para el prompt</label>
                <textarea id="instruccion-extra" class="form-control" rows="2" placeholder="Por ejemplo: añademe 3 preguntas donde me pidas penas de prisión"></textarea>
                <small class="text-muted">Opcional. Al copiar el prompt se incluye esta instrucción. Si la dejas vacía, el prompt sale como siempre.</small>
            </div>

            <div class="d-flex gap-2 mb-3 flex-wrap">
                <button type="button" class="btn btn-secondary" id="copiar-prompt">Copiar prompt</button>
                <span id="prompt-copiado" style="display: none; align-self: center; color: #198754;">Prompt copiado. Pégalo en Claude y añade el contenido debajo.</span>
            </div>

            <div class="mb-3">
                <label for="bloque" class="form-label">Respuesta de Claude <span class="text-danger">*</span></label>
                <textarea name="bloque" id="bloque" class="form-control" required placeholder="Pega aquí los bloques que devuelva Claude">{{ bloqueInicial|default('') }}</textarea>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Previsualizar</button>
                <a href="{{ path(rutaCancelar) }}" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<script type="application/json" id="temas-datos">{{ temasDatos|json_encode|raw }}</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const cantidadPreguntas = {{ cantidadPreguntas }};
    const temasDatos = JSON.parse(document.getElementById('temas-datos').textContent);
    const temasPorId = {};
    temasDatos.forEach(function(tema) {
        temasPorId[String(tema.id)] = tema;
    });
    function elegirLey(id, nombre) {
        document.getElementById('ley-value').value = id;
        document.getElementById('ley-display').textContent = nombre;
        document.getElementById('ley-options').querySelectorAll('.select-option').forEach(opt => {
            opt.classList.toggle('selected', opt.getAttribute('data-value') === String(id));
        });
    }

    function loadLeyes(temaId) {
        const leyDisplay = document.getElementById('ley-display');
        const leyValue = document.getElementById('ley-value');
        const leyOptions = document.getElementById('ley-options');

        leyValue.value = '';
        if (!temaId) {
            leyDisplay.textContent = 'Primero selecciona un tema';
            leyOptions.innerHTML = '<div class="select-option" style="color: #999; cursor: default;">Primero selecciona un tema</div>';
            return;
        }

        leyDisplay.textContent = 'Cargando...';
        fetch('/pregunta/api/leyes-por-tema/' + temaId)
            .then(response => response.json())
            .then(data => {
                const leyes = data.filter(ley => ley.activo !== false);
                leyOptions.innerHTML = '';
                if (leyes.length === 0) {
                    leyDisplay.textContent = 'Este tema no tiene leyes';
                    return;
                }
                leyes.forEach(ley => {
                    const option = document.createElement('div');
                    option.className = 'select-option';
                    option.setAttribute('data-value', ley.id);
                    option.setAttribute('data-text', ley.nombre);
                    option.textContent = ley.nombre;
                    option.addEventListener('click', function() {
                        elegirLey(ley.id, ley.nombre);
                        leyOptions.classList.remove('show');
                        document.getElementById('ley-search').style.display = 'none';
                    });
                    leyOptions.appendChild(option);
                });
                if (leyes.length === 1) {
                    elegirLey(leyes[0].id, leyes[0].nombre);
                } else {
                    leyDisplay.textContent = 'Selecciona una ley';
                }
            })
            .catch(() => {
                leyDisplay.textContent = 'Error al cargar las leyes';
            });
    }

    function initSearchableSelect(containerId, displayId, searchId, optionsId, valueId) {
        const container = document.getElementById(containerId);
        const display = document.getElementById(displayId);
        const search = document.getElementById(searchId);
        const options = document.getElementById(optionsId);
        const valueInput = document.getElementById(valueId);

        function filterOptions(query) {
            options.querySelectorAll('.select-option').forEach(option => {
                const text = option.getAttribute('data-text') || '';
                option.style.display = text.toLowerCase().includes(query.toLowerCase()) ? 'block' : 'none';
            });
        }

        function closeSelect() {
            options.classList.remove('show');
            search.style.display = 'none';
            search.value = '';
            filterOptions('');
        }

        display.addEventListener('click', function(e) {
            e.stopPropagation();
            const abierto = options.classList.contains('show');
            document.querySelectorAll('.select-options').forEach(lista => lista.classList.remove('show'));
            document.querySelectorAll('.search-input').forEach(campo => { campo.style.display = 'none'; });
            if (!abierto) {
                options.classList.add('show');
                search.style.display = 'block';
                search.focus();
            }
        });

        search.addEventListener('input', function(e) {
            filterOptions(e.target.value);
        });

        options.querySelectorAll('.select-option').forEach(option => {
            option.addEventListener('click', function() {
                const selectedValue = option.getAttribute('data-value');
                if (!selectedValue) {
                    return;
                }
                valueInput.value = selectedValue;
                display.textContent = option.getAttribute('data-text');
                options.querySelectorAll('.select-option').forEach(opt => opt.classList.remove('selected'));
                option.classList.add('selected');
                closeSelect();
                if (containerId === 'tema-select-container') {
                    loadLeyes(selectedValue);
                }
            });
        });

        document.addEventListener('click', function(e) {
            if (!container.contains(e.target)) {
                closeSelect();
            }
        });
    }

    initSearchableSelect('tema-select-container', 'tema-display', 'tema-search', 'tema-options', 'tema-value');
    initSearchableSelect('ley-select-container', 'ley-display', 'ley-search', 'ley-options', 'ley-value');

    function modoAleatorio() {
        return document.getElementById('modo-aleatorio').checked;
    }

    function aplicarModo() {
        const aleatorio = modoAleatorio();
        document.getElementById('fila-tema-unico').style.display = aleatorio ? 'none' : '';
        document.getElementById('fila-temas-aleatorios').style.display = aleatorio ? '' : 'none';
        document.getElementById('tema-value').required = !aleatorio;
        document.getElementById('ley-value').required = !aleatorio;
        document.querySelectorAll('.tema-aleatorio-check').forEach(function(casilla) {
            casilla.disabled = !aleatorio;
        });
        document.getElementById('modo-ayuda').textContent = aleatorio
            ? 'Marca los temas del sorteo. Cada pregunta saldrá de uno de ellos, al azar.'
            : 'El prompt se centra en el tema y la ley que elijas.';
    }

    document.querySelectorAll('input[name="modo"]').forEach(function(radio) {
        radio.addEventListener('change', aplicarModo);
    });

    const buscarTemas = document.getElementById('temas-aleatorio-buscar');
    buscarTemas.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
        }
    });
    buscarTemas.addEventListener('input', function() {
        const consulta = buscarTemas.value.trim().toLowerCase();
        document.querySelectorAll('.tema-aleatorio-item').forEach(function(item) {
            const texto = (item.getAttribute('data-text') || '').toLowerCase();
            item.style.display = texto.includes(consulta) ? '' : 'none';
        });
    });
    document.getElementById('temas-aleatorio-todos').addEventListener('click', function() {
        document.querySelectorAll('.tema-aleatorio-check').forEach(function(casilla) {
            casilla.checked = true;
        });
    });
    document.getElementById('temas-aleatorio-ninguno').addEventListener('click', function() {
        document.querySelectorAll('.tema-aleatorio-check').forEach(function(casilla) {
            casilla.checked = false;
        });
    });

    function textoDificultad() {
        const dificultadSelect = document.getElementById('dificultad');
        if (!dificultadSelect.value) {
            return '';
        }
        return dificultadSelect.options[dificultadSelect.selectedIndex].text;
    }

    function temasMarcados() {
        return Array.from(document.querySelectorAll('.tema-aleatorio-check:checked')).map(function(casilla) {
            return temasPorId[casilla.value];
        }).filter(Boolean);
    }

    function seleccionValida() {
        const dificultad = textoDificultad();
        if (modoAleatorio()) {
            const temas = temasMarcados();
            if (!dificultad) {
                alert('Elige la dificultad antes de continuar.');
                return null;
            }
            if (temas.length < 2) {
                alert('Marca al menos dos temas. Las preguntas se repartirán al azar entre ellos.');
                return null;
            }
            const sinLeyes = temas.filter(function(tema) { return !tema.leyes.length; });
            if (sinLeyes.length) {
                alert('Estos temas no tienen leyes activas: ' + sinLeyes.map(function(tema) { return tema.nombre; }).join(', ') + '.');
                return null;
            }
            return { aleatorio: true, temas: temas, dificultad: dificultad };
        }

        const tema = document.getElementById('tema-value').value;
        const ley = document.getElementById('ley-value').value;
        if (!tema || !ley || !dificultad) {
            alert('Elige tema, ley y dificultad antes de continuar.');
            return null;
        }
        return {
            aleatorio: false,
            tema: document.getElementById('tema-display').textContent.trim(),
            ley: document.getElementById('ley-display').textContent.trim(),
            dificultad: dificultad
        };
    }

    function lineasInstruccionExtra() {
        const campo = document.getElementById('instruccion-extra');
        const texto = campo ? campo.value.trim() : '';
        if (!texto) {
            return [];
        }
        return [
            'Instrucción adicional (cúmplela sí o sí, además del resto):',
            texto,
            'Si esa instrucción pide un número de preguntas sobre un asunto, haz exactamente esas dentro del total de ' + cantidadPreguntas + ', con el mismo formato. El resto completa el bloque. No inventes datos que no estén en el CONTENIDO.',
            ''
        ];
    }

    function construirPrompt(datos) {
        return [
            'Eres un preparador de oposiciones de policía local en Baleares. Genera exactamente ' + cantidadPreguntas + ' preguntas tipo test, en español, solo con el contenido que pegue debajo de CONTENIDO. No inventes datos que no estén en ese texto.',
            '',
            'Tema: ' + datos.tema,
            'Ley: ' + datos.ley,
            'Dificultad: ' + datos.dificultad,
            '',
            ...lineasInstruccionExtra(),
            'Reglas:',
            '- Una sola respuesta correcta. La letra de la opción correcta tiene que variar de una pregunta a otra: no puede ser siempre la misma. A lo largo del bloque deben aparecer A, B, C y D. Las otras tres opciones tienen que ser plausibles.',
            '- Cada enunciado es una pregunta tipo test y cita siempre la norma y el artículo. Nombra la norma exactamente como aparece arriba y el número del artículo.',
            '- La línea ARTICULO lleva el número del artículo tal como está en el texto (14 o 14 bis). Es el mismo artículo que cita el enunciado. No inventes artículos que no estén en el contenido.',
            '- La explicación cita el fragmento del que sale la respuesta.',
            '- Responde solo con los bloques, sin introducción ni markdown.',
            '- Si el contenido no da para ' + cantidadPreguntas + ', devuelve las que salgan y dilo en una línea al final, fuera de los bloques.',
            '- Si después escribo «continúa», genera otras ' + cantidadPreguntas + ' distintas, del mismo contenido, en el mismo formato.',
            '',
            'Formato de cada pregunta:',
            '',
            '---',
            'ARTICULO: 14',
            'PREGUNTA: Según ' + datos.ley + ', el artículo 14, ¿qué establece?',
            'A: opcion',
            'B: opcion',
            'C: opcion',
            'D: opcion',
            'CORRECTA: B',
            'EXPLICACION: por qué, citando el texto',
            '---',
            '',
            'La B de CORRECTA en el ejemplo es solo el formato. En las preguntas reales cambia la letra.',
            '',
            'CONTENIDO:'
        ].join('\n');
    }

    function construirPromptAleatorio(datos) {
        const temasOrdenados = datos.temas.slice().sort(function(a, b) {
            return a.nombre.localeCompare(b.nombre, 'es', { numeric: true, sensitivity: 'base' });
        });
        const lineasTemas = temasOrdenados.map(function(tema) {
            const leyes = tema.leyes.map(function(ley) { return ley.nombre; }).join('; ');
            return '- ' + tema.nombre + ': ' + leyes;
        });
        const ejemplo = temasOrdenados[0];
        const leyEjemplo = ejemplo.leyes[0].nombre;
        return [
            'Eres un preparador de oposiciones de policía local en Baleares. Genera exactamente ' + cantidadPreguntas + ' preguntas tipo test, en español, solo con el contenido que pegue debajo de CONTENIDO. No inventes datos que no estén en ese texto.',
            '',
            'No hagas las ' + cantidadPreguntas + ' preguntas de un solo tema. Cada pregunta es de uno de estos temas, elegido al azar. Reparte el bloque entre ellos: tienen que salir temas distintos.',
            '',
            'Temas y sus normas (usa el nombre exacto):',
            ...lineasTemas,
            '',
            'Dificultad: ' + datos.dificultad,
            '',
            ...lineasInstruccionExtra(),
            'Reglas:',
            '- Una sola respuesta correcta. La letra de la opción correcta tiene que variar de una pregunta a otra: no puede ser siempre la misma. A lo largo del bloque deben aparecer A, B, C y D. Las otras tres opciones tienen que ser plausibles.',
            '- Cada pregunta lleva la línea TEMA con el nombre exacto de uno de los temas de la lista, y la línea LEY con el nombre exacto de una norma de ese tema.',
            '- Reparte las preguntas al azar entre los temas de la lista. No concentres el bloque en un único tema.',
            '- Cada enunciado es una pregunta tipo test y cita siempre la norma y el artículo. Nombra la norma exactamente como en la línea LEY y el número del artículo.',
            '- La línea ARTICULO lleva el número del artículo tal como está en el texto (14 o 14 bis). Es el mismo artículo que cita el enunciado. No inventes artículos que no estén en el contenido.',
            '- La explicación cita el fragmento del que sale la respuesta.',
            '- Responde solo con los bloques, sin introducción ni markdown.',
            '- Si el contenido no da para ' + cantidadPreguntas + ', devuelve las que salgan y dilo en una línea al final, fuera de los bloques.',
            '- Si después escribo «continúa», genera otras ' + cantidadPreguntas + ' distintas, del mismo contenido, repartidas otra vez al azar entre esos temas, en el mismo formato.',
            '',
            'Formato de cada pregunta:',
            '',
            '---',
            'TEMA: ' + ejemplo.nombre,
            'LEY: ' + leyEjemplo,
            'ARTICULO: 14',
            'PREGUNTA: Según ' + leyEjemplo + ', el artículo 14, ¿qué establece?',
            'A: opcion',
            'B: opcion',
            'C: opcion',
            'D: opcion',
            'CORRECTA: B',
            'EXPLICACION: por qué, citando el texto',
            '---',
            '',
            'La B de CORRECTA en el ejemplo es solo el formato. En las preguntas reales cambia la letra. El TEMA de cada pregunta tiene que ir cambiando entre los de la lista.',
            '',
            'CONTENIDO:'
        ].join('\n');
    }

    document.getElementById('copiar-prompt').addEventListener('click', function() {
        const datos = seleccionValida();
        if (!datos) {
            return;
        }
        const prompt = datos.aleatorio ? construirPromptAleatorio(datos) : construirPrompt(datos);
        const aviso = document.getElementById('prompt-copiado');
        const mostrar = function() {
            aviso.style.display = 'inline';
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(prompt).then(mostrar).catch(function() {
                window.prompt('Copia este prompt:', prompt);
                mostrar();
            });
        } else {
            window.prompt('Copia este prompt:', prompt);
            mostrar();
        }
    });

    aplicarModo();

    function examenListo() {
        const destino = document.querySelector('input[name="destino"]');
        if (!destino || destino.value !== 'examen') {
            return true;
        }
        const nombre = document.getElementById('examen-nombre').value.trim();
        const apertura = document.getElementById('examen-apertura').value;
        const cierre = document.getElementById('examen-cierre').value;
        if (!nombre || !apertura || !cierre) {
            alert('Completa el nombre y las fechas del examen semanal.');
            return false;
        }
        if (cierre <= apertura) {
            alert('La fecha de cierre tiene que ser posterior a la de apertura.');
            return false;
        }
        return true;
    }

    document.getElementById('pegar-form').addEventListener('submit', function(e) {
        if (!examenListo() || !seleccionValida()) {
            e.preventDefault();
            return;
        }
        if (!document.getElementById('bloque').value.trim()) {
            e.preventDefault();
            alert('Pega la respuesta de Claude.');
        }
    });
});
</script>
{% endblock %}

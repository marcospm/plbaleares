{% extends 'base.html.twig' %}

{% block title %}Flashcards de {{ alumno.nombreDisplay }} - Gamificación - BISPOL{% endblock %}

{% block body %}
<div class="container">
    <div style="margin-bottom: 1.5rem;">
        <h1 style="color: var(--color-primary); margin-bottom: 0.5rem;">🗂️ Flashcards de {{ alumno.nombreDisplay }}</h1>
        <p style="color: #666; margin-top: 0;">{{ alumno.username }} · {{ total }} {{ total == 1 ? 'tarjeta' : 'tarjetas' }}</p>
        <a href="{{ path('app_gamificacion_admin') }}" class="btn btn-secondary">← Volver al listado</a>
    </div>

    {% if total == 0 %}
        <div class="alert alert-info">Este alumno todavía no tiene flashcards.</div>
    {% else %}
        {% for grupo in grupos %}
            <section style="margin-bottom: 2rem;">
                <h2 style="margin: 0 0 0.75rem; font-size: 1.25rem;">{{ grupo.nombre }}</h2>
                {% for flashcard in grupo.flashcards %}
                    <article class="card" style="margin-bottom: 0.75rem;">
                        <div class="card-body">
                            {% if flashcard.leyVisible %}
                                <p style="margin: 0 0 0.75rem; color: #555;">{{ flashcard.leyVisible.nombre }}</p>
                            {% endif %}
                            <p style="margin: 0 0 0.35rem; font-size: 0.8rem; color: #777; text-transform: uppercase; letter-spacing: 0.04em;">Pregunta</p>
                            <div style="margin-bottom: 0.75rem; line-height: 1.5;">{{ flashcard.anverso|nl2br }}</div>
                            <p style="margin: 0 0 0.35rem; font-size: 0.8rem; color: #777; text-transform: uppercase; letter-spacing: 0.04em;">Respuesta</p>
                            <div style="padding: 0.75rem; background: #e8f5e9; border-left: 3px solid var(--color-success); border-radius: 4px; line-height: 1.5;">{{ flashcard.reverso|nl2br }}</div>
                            <p style="margin: 0.75rem 0 0; color: #888; font-size: 0.8rem;">
                                Actualizada el {{ flashcard.actualizadoEn|date('d/m/Y H:i') }}
                            </p>
                        </div>
                    </article>
                {% endfor %}
            </section>
        {% endfor %}
    {% endif %}
</div>
{% endblock %}
